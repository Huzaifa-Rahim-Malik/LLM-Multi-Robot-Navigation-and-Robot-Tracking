<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS unicast discovery profile for the control PC <-> TurtleBot 4 (Wi-Fi).
  Copy to ros/fastdds_pc.xml (git-ignored) and replace:
    PC_IP     : this PC's Wi-Fi address
    ROBOT_IP  : the TurtleBot 4 Raspberry Pi address
  Discovery-server ports follow 7400 + 250*domain_id + 2*participant_id; with
  ROS_DOMAIN_ID=23 the robot's participants sit on 13160 + 2*n. Add or remove
  <locator> lines to cover the participant ids you actually use (the original
  setup listed 13160 ... 13278 in steps of 2).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_wifi</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>PC_IP</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>udp_wifi</transport_id></userTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>ROBOT_IP</address><port>13160</port></udpv4></locator>
          <locator><udpv4><address>ROBOT_IP</address><port>13162</port></udpv4></locator>
          <locator><udpv4><address>ROBOT_IP</address><port>13164</port></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
